# Build directories
build/
build-*/
cmake-build-*/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Compiled files
*.o
*.obj
*.ptx
*.cubin

# Compile cache sidecars. These sit next to the cubins and record an absolute
# source path, so they must never be committed. They land in kernels/ rather
# than build/kernels/ whenever the binary runs with the repo root as its
# working directory, since KernelCompiler's cache path is relative.
kernels/*.json
*.a
*.so

# Binaries
*.exe
# root-anchored: a bare "arena" also matches the include/arena and src/arena
# directories, which silently swallows every new source file added there
/arena

# Python
*.pyc
__pycache__/
.pytest_cache/

# Runtime output
*.log
arena.log
imgui.ini
gpgpu_arena_results.csv

# Local overrides
.env
*.local
