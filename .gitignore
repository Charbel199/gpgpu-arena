# Build directories
build/
build-*/
cmake-build-*/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Compiled files
*.o
*.obj
*.ptx
*.cubin

# Compile cache sidecars. These sit next to the cubins and record an absolute
# source path, so they must never be committed. They land in kernels/ rather
# than build/kernels/ whenever the binary runs with the repo root as its
# working directory, since KernelCompiler's cache path is relative.
kernels/*.json
# Everything else the compile cache writes there (Triton IR, Warp's generated
# CUDA) for sources outside kernels/, such as PGAIO candidates.
kernels/ext_*
*.a
*.so

# Binaries
*.exe
# root-anchored: a bare "arena" also matches the include/arena and src/arena
# directories, which silently swallows every new source file added there
/arena

# Python
*.pyc
__pycache__/
.pytest_cache/

# Runtime output
*.log
arena.log
imgui.ini
gpgpu_arena_results.csv

# Local overrides
.env
*.local

# .claude/ is tracked for its skills link; personal settings stay local
.claude/settings.local.json

# PGAIO run directories: candidates, journals, observations and compiler
# dumps. Kept out of git; open them in the GUI or read journal.md and
# progress.html. pgaio/learnings.jsonl is tracked.
pgaio/runs/
